# Production stack (docker-compose.yml). Copy to .env on the server and keep it chmod 600.
# Local development uses apps/api/.env instead.
APP_ORIGIN=https://athena.example.edu
POSTGRES_PASSWORD=change-me
# 32+ random bytes, e.g. `openssl rand -hex 32`. Keys the grade-ledger hash chain and submission receipts.
LEDGER_SECRET=change-me-to-a-long-random-value
LOG_LEVEL=info
GEMINI_API_KEY=
GEMINI_MODEL=
