{
  "name": "@athena/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed/index.ts"
  },
  "dependencies": {
    "@athena/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@react-pdf/renderer": "4.9.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "8.3.0",
    "mathjs": "15.3.0",
    "papaparse": "5.7.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "^7.3.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
